{
  "name": "polymarket-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:safety": "playwright test --config playwright.safety.config.ts",
    "test:research": "playwright test --config playwright.research.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:walletconnect": "playwright test --config playwright.walletconnect.config.ts",
    "test:observations": "playwright test --config playwright.observations.config.ts",
    "test:book": "playwright test --config playwright.book.config.ts"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "^2.23.7",
    "axios": "^1.20.0",
    "ethers": "^6.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-query": "^3.39.0",
    "react-router-dom": "^6.30.6",
    "react-virtuoso": "^4.12.7",
    "recharts": "^2.10.0",
    "tailwindcss": "^3.3.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@mcp-b/webmcp-polyfill": "^6.0.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.31",
    "prettier": "^3.9.9",
    "typescript": "^5.2.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "utf-8-validate": "^5.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
