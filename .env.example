# Polymarket AI Trading - Environment Variables
# Copy this file to .env and fill in your values

# REQUIRED: JWT Secret Key for token signing
# Must be at least 32 chars and not a placeholder.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Optional: dedicated secret for deterministic refresh-token hashing.
# If empty, JWT_SECRET_KEY is used.
REFRESH_TOKEN_HASH_SECRET=

# REQUIRED: Comma-separated Fernet keys used to encrypt cached credentials.
# First key is used for encryption; all keys are used for decryption (rotation-safe).
# Generate one key with:
# python - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
ENCRYPTION_MASTER_KEYS=

# Optional: encrypted credential cache TTL in seconds (default: 3600).
CREDENTIAL_CACHE_TTL_SECONDS=3600

# Require Redis for credential cache in non-local environments.
REQUIRE_REDIS_FOR_CREDENTIALS=true

# Redis auth password (used by docker-compose Redis service).
REDIS_PASSWORD=dev_redis_password

# ===========================================
# LLM CONFIGURATION (Provider-Agnostic)
# ===========================================

# LLM Provider: openai, anthropic, google, groq, ollama
LLM_PROVIDER=openai

# Model name (varies by provider). Default: gpt-4o-mini.
# OpenAI: gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, gpt-4o, gpt-4o-mini
# Anthropic: claude-sonnet-4, claude-haiku-4-5, claude-opus-4
# Google: gemini-2.5-flash, gemini-2.5-pro
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Ollama: llama3.2, llama3.1, mistral, codellama, phi3
LLM_MODEL=gpt-4o-mini

# LLM Parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ===========================================
# PER-TASK MODEL TIERING
# ===========================================
# Route each analysis task to a model tier:
#   CHEAP     (gpt-4o-mini, t=0.0,  512 tokens)  classification/extraction/paraphrase
#   STANDARD  (gpt-4o-mini, t=0.2, 2048 tokens)  everyday analysis
#   STRONG    (gpt-4o,      t=0.2, 2048 tokens)  forecasting / trading decisions
#   WRITER    (gpt-4o,      t=0.6, 4096 tokens)  long-form news articles
# Set to false to force every task onto LLM_MODEL above (kill switch).
LLM_TIERING_ENABLED=true
# Reasoning effort for the STRONG tier (OpenAI only): low|medium|high
LLM_STRONG_REASONING_EFFORT=medium
# Per-tier overrides (empty model = tier default; unset temp/tokens = tier default).
# LLM_TIER_CHEAP_MODEL=
# LLM_TIER_CHEAP_TEMPERATURE=
# LLM_TIER_CHEAP_MAX_TOKENS=
# LLM_TIER_STANDARD_MODEL=
# LLM_TIER_STANDARD_TEMPERATURE=
# LLM_TIER_STANDARD_MAX_TOKENS=
# LLM_TIER_STRONG_MODEL=
# LLM_TIER_STRONG_TEMPERATURE=
# LLM_TIER_STRONG_MAX_TOKENS=
# LLM_TIER_WRITER_MODEL=
# LLM_TIER_WRITER_TEMPERATURE=
# LLM_TIER_WRITER_MAX_TOKENS=

# ===========================================
# LLM PROVIDER API KEYS (only one required)
# ===========================================

# OpenAI API Key (if using openai provider)
OPENAI_API_KEY=

# Anthropic API Key (if using anthropic provider)
ANTHROPIC_API_KEY=

# Google AI API Key (if using google provider)
GOOGLE_API_KEY=

# Groq API Key (if using groq provider)
GROQ_API_KEY=

# Ollama Base URL (if using ollama provider - local models)
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# POLYMARKET CONFIGURATION
# ===========================================

# REQUIRED: Polymarket wallet private key for trading
POLYMARKET_PRIVATE_KEY=

# Polymarket chain ID (default: 137 for Polygon Mainnet)
POLYMARKET_CHAIN_ID=137

# AI Backend Configuration
# Default backend: llm_chain or cli_agent
DEFAULT_AI_BACKEND=llm_chain

# gRPC timeout in seconds
GRPC_TIMEOUT=60

# MCP Tool API Keys (for CLI Agent)
# GitHub token (optional, for GitHub MCP)
GITHUB_TOKEN=

# ===========================================
# RESEARCH PROVIDERS (Optional - enhances analysis quality)
# ===========================================

# Tavily API Key — premium AI-optimised search (https://tavily.com)
# Free tier: 1,000 searches/month. Set TAVILY_ENABLED=true to activate.
# Example: TAVILY_API_KEY=tvly-AbCdEf123456789xyz
TAVILY_API_KEY=
TAVILY_ENABLED=false

# NewsAPI Key — real-time news headlines (https://newsapi.org)
# Free tier: 100 requests/day. Set NEWSAPI_ENABLED=true to activate.
# Example: NEWSAPI_API_KEY=a1b2c3d4e5f6789012345678901234ab
NEWSAPI_API_KEY=
NEWSAPI_ENABLED=false

# ChromaDB RAG — vector search for market discovery (no API key needed)
RAG_ENABLED=true

# Logging level
LOG_LEVEL=INFO

# Runtime environment: development | local | test | production
ENVIRONMENT=development

# Comma-separated browser origins allowed for credentialed CORS requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug endpoint switch (default disabled for safety)
DEBUG_ENDPOINTS_ENABLED=false

# Required if DEBUG_ENDPOINTS_ENABLED=true.
# Used as HMAC salt for anonymized request-log IP hashing.
DEBUG_LOG_HASH_SALT=

# ===========================================
# ADMIN CONFIGURATION
# ===========================================

# Comma-separated wallet addresses that have admin privileges
# Admin users can access the Debug Dashboard at /debug
# Example: ADMIN_WALLETS=0xabc123...,0xdef456...
ADMIN_WALLETS=

# Safety valve: when false and ADMIN_WALLETS is empty, startup sync does not
# mass-demote all admins.
ADMIN_SYNC_ALLOW_EMPTY=false
