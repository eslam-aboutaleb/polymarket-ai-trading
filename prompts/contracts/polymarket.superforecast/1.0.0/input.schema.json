{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "description",
    "outcome_prices",
    "outcomes",
    "research_context",
    "sentiment_context"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    },
    "outcome_prices": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "outcomes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "research_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    },
    "sentiment_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    }
  }
}
