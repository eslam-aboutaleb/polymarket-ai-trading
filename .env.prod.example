# ── Production Environment Variables ───────────────────────────
# Copy to .env.prod and fill in ALL values before deploying.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ───────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════
# DATABASE (required — no weak defaults)
# ═══════════════════════════════════════════════════════════════
# Generate password: openssl rand -base64 24
POSTGRES_USER=polymarket_user
POSTGRES_PASSWORD=
POSTGRES_DB=polymarket

# ═══════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════
# Generate password: openssl rand -base64 24
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════
# AUTH & SECURITY (required)
# ═══════════════════════════════════════════════════════════════
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=
REFRESH_TOKEN_HASH_SECRET=

# Fernet key for credential encryption.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEYS=
CREDENTIAL_CACHE_TTL_SECONDS=3600

# ═══════════════════════════════════════════════════════════════
# POLYMARKET
# ═══════════════════════════════════════════════════════════════
POLYMARKET_PRIVATE_KEY=
POLYMARKET_CHAIN_ID=137

# ═══════════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════════
LLM_PROVIDER=openai
# Default model: gpt-4o-mini (replaces the retired gpt-4-turbo-preview).
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Per-task model tiering (CHEAP/STANDARD/STRONG/WRITER).
# Set LLM_TIERING_ENABLED=false to force every task onto LLM_MODEL.
LLM_TIERING_ENABLED=true
# Reasoning effort for the STRONG tier (OpenAI only): low|medium|high
LLM_STRONG_REASONING_EFFORT=medium
# Per-tier overrides (empty model = tier default):
# LLM_TIER_CHEAP_MODEL, LLM_TIER_CHEAP_TEMPERATURE, LLM_TIER_CHEAP_MAX_TOKENS
# LLM_TIER_STANDARD_MODEL, LLM_TIER_STANDARD_TEMPERATURE, LLM_TIER_STANDARD_MAX_TOKENS
# LLM_TIER_STRONG_MODEL, LLM_TIER_STRONG_TEMPERATURE, LLM_TIER_STRONG_MAX_TOKENS
# LLM_TIER_WRITER_MODEL, LLM_TIER_WRITER_TEMPERATURE, LLM_TIER_WRITER_MAX_TOKENS

# Provider API keys (fill only the one matching LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=

# CLI Agent (GitHub Models)
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════
# RESEARCH PROVIDERS (optional)
# ═══════════════════════════════════════════════════════════════
TAVILY_API_KEY=
TAVILY_ENABLED=false
NEWSAPI_API_KEY=
NEWSAPI_ENABLED=false
RAG_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# AI BACKEND
# ═══════════════════════════════════════════════════════════════
DEFAULT_AI_BACKEND=llm_chain
GRPC_TIMEOUT=60

# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
# CORS: comma-separated origins allowed (your domain)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Uvicorn worker count (2 per CPU core is a good starting point)
WEB_CONCURRENCY=2

# WalletConnect browser build ID. Supply via deployment environment or .env.prod.
# For GitHub Actions builds, the repository Actions secret is injected by CI.
VITE_WALLETCONNECT_PROJECT_ID=

# Frontend port on host
FRONTEND_PORT=80

# Log level for gRPC services
LOG_LEVEL=WARNING

# Debug (keep disabled in production)
DEBUG_ENDPOINTS_ENABLED=false
DEBUG_LOG_HASH_SALT=

# Admin wallets (comma-separated addresses)
ADMIN_WALLETS=

# Live features are enabled by default; choose paper/simulation for virtual funds.
# Apply migrations and configure principal budgets,
# then activate global execution (admin) and the account via /api/v1/risk/activate.
# Legacy direct signers remain blocked.
LIVE_TRADING_ENABLED=true
LIVE_MARKET_MAKING_ENABLED=true
LIVE_COPY_TRADING_ENABLED=true
LIVE_INVERSE_TRADING_ENABLED=true
LIVE_LATENCY_ARB_ENABLED=true
LATENCY_ARB_LIVE=true

# Portable gateway (backend LLM service only). Set LLM_PROVIDER=litellm.
# Use provider-qualified models, e.g. openai/<gateway-chat-alias>.
# Leave optional variables UNSET unless overriding; see docs/litellm-gateway.md.
# LITELLM_API_BASE=https://gateway.example/v1
# LITELLM_API_KEY=<virtual-key>
# LITELLM_MODEL=openai/<chat-alias>
# LITELLM_EMBEDDING_MODEL=openai/<embedding-alias>
# LITELLM_EMBEDDING_DIMENSIONS=<positive-integer>
# LITELLM_EMBEDDING_API_KEY=<independent-key>
# LITELLM_EMBEDDING_API_BASE=https://embedding.example/v1
