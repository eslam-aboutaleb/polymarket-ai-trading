# ── Backend Production Dockerfile ──────────────────────────────
# Non-root user, no --reload, proper layer caching
# ───────────────────────────────────────────────────────────────
FROM python:3.11-slim AS base

WORKDIR /app

# System deps (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install UV
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# ── Deps layer (cached until pyproject.toml changes) ──────────
COPY pyproject.toml .
RUN uv sync --no-dev

# ── Application code ──────────────────────────────────────────
COPY app ./app
COPY database ./database
COPY proto ./proto
COPY migrations ./migrations
COPY alembic.ini .

# Generate gRPC stubs
RUN uv run python3 -m grpc_tools.protoc \
        -Iproto \
        --python_out=app/grpc_clients \
        --grpc_python_out=app/grpc_clients \
        proto/analysis.proto \
    && sed -i 's/^import analysis_pb2/from app.grpc_clients import analysis_pb2/' \
        app/grpc_clients/analysis_pb2_grpc.py

# ── Non-root user ─────────────────────────────────────────────
RUN useradd -m -u 1000 -s /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

# UV was installed for root — symlink so appuser can use it too
ENV PATH="/root/.local/bin:$PATH"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Production: no --reload, 2 workers (tune via $WEB_CONCURRENCY)
CMD ["sh", "-c", "uv run alembic upgrade head && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY:-2} --log-level info"]
