# ── Backend Production Dockerfile ──────────────────────────────
# Non-root user, no --reload, proper layer caching
# ───────────────────────────────────────────────────────────────
FROM python:3.11-slim AS base

WORKDIR /app

# System deps (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install UV into a system path so the non-root appuser
# (created below) can execute it — /root is not traversable
# by appuser, so the default ~/.local/bin install location
# would break every `uv run ...` in the CMD.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh -s -- --install-dir /usr/local/bin
ENV PATH="/usr/local/bin:$PATH"

# ── Deps layer (cached until pyproject.toml changes) ──────────
COPY pyproject.toml .
RUN uv sync --no-dev

# ── Application code ──────────────────────────────────────────
COPY app ./app
COPY database ./database
COPY proto ./proto
COPY migrations ./migrations
COPY alembic.ini .

# Generate gRPC stubs
RUN uv run python3 -m grpc_tools.protoc \
        -Iproto \
        --python_out=app/grpc_clients \
        --grpc_python_out=app/grpc_clients \
        proto/analysis.proto \
    && sed -i 's/^import analysis_pb2/from app.grpc_clients import analysis_pb2/' \
        app/grpc_clients/analysis_pb2_grpc.py

# ── Non-root user ─────────────────────────────────────────────
RUN useradd -m -u 1000 -s /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8002/health || exit 1

# Production: no --reload. Default to a SINGLE worker.
#
# Every scheduled background job (stop-loss monitor, inverse bot, market maker,
# trade monitor, aggregation, lifecycle) starts from the FastAPI lifespan, and
# every one of them de-duplicates through process-local in-memory state. With
# more than one worker, each process runs its own copy, so a single stop-loss
# trigger placed two independent sell orders. Raising WEB_CONCURRENCY requires
# moving the schedulers behind a Postgres advisory lock first.
CMD ["sh", "-c", "uv run alembic upgrade head && uv run uvicorn app.main:app --host 0.0.0.0 --port 8002 --workers ${WEB_CONCURRENCY:-1} --log-level info"]
